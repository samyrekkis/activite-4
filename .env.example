# URL publique de ce serveur (HTTPS obligatoire pour Vapi)
PUBLIC_BASE_URL=https://agent.mon-agence.dz
# Clé privée Vapi (Dashboard Vapi > Organization > API Keys)
VAPI_API_KEY=
# Secret partagé : Vapi l'envoie dans l'en-tête x-vapi-secret, le serveur le vérifie
VAPI_WEBHOOK_SECRET=change-moi-secret-long
# Bot Telegram qui envoie les notifications aux cabinets (@BotFather)
TELEGRAM_BOT_TOKEN=
# Jeton administrateur (accès à tous les tableaux de bord)
ADMIN_TOKEN=change-moi-admin
DATABASE_PATH=data/agent.db
CLIENTS_DIR=clients
NICHES_DIR=niches

# --- Chatbot WhatsApp (API officielle Meta, voir docs/09-whatsapp.md)
# Clé API Anthropic (console.anthropic.com) : l'IA qui répond sur WhatsApp
ANTHROPIC_API_KEY=
# Jeton permanent d'un « utilisateur système » Meta Business avec les droits whatsapp_business_messaging
WHATSAPP_TOKEN=
# Clé secrète de l'application Meta (Paramètres > Général) : vérifie que les messages viennent bien de Meta
WHATSAPP_APP_SECRET=
# Mot de passe libre que tu recopies dans la configuration du webhook chez Meta
WHATSAPP_VERIFY_TOKEN=change-moi
WHATSAPP_API_VERSION=v23.0
MODELE_CHAT=claude-opus-5-5
EFFORT_CHAT=low
